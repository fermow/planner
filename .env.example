# ── Celestial Desk configuration ──────────────────────────
# Copy this file to `.env` and adjust for your machine.

# Your local timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
# Leave unset to use UTC. On Linux, scripts/start.sh auto-detects your system
# timezone (e.g. Europe/Berlin, America/New_York, Asia/Tehran). On Windows,
# set it here manually.
TZ=UTC

# Backend log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Where data is stored *inside the container*. Do not change unless
# you know what you are doing — the host folder is always ./data.
DATA_DIR=/data

